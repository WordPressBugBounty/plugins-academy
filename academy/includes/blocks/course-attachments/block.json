{
	"$schema": "https://schemas.wp.org/trunk/block.json",
	"apiVersion": 3,
	"name": "academy/course-attachments",
	"title": "Course Attachments",
	"category": "academy-course",
	"description": "Downloadable course files, shown to enrolled students.",
	"keywords": [
		"attachments",
		"files",
		"downloads",
		"resources",
		"course"
	],
	"textdomain": "academy",
	"usesContext": [
		"postId",
		"postType"
	],
	"supports": {
		"align": [
			"wide",
			"full"
		],
		"html": false,
		"multiple": true,
		"color": {
			"text": true,
			"background": true,
			"link": true
		},
		"spacing": {
			"margin": true,
			"padding": true
		},
		"typography": {
			"fontSize": true,
			"lineHeight": true
		},
		"__experimentalBorder": {
			"radius": true,
			"width": true,
			"color": true,
			"style": true
		},
		"shadow": true
	},
	"editorScript": "academy-blocks-editor",
	"render": "file:./render.php",
	"attributes": {
		"accentColor": {
			"type": "string"
		},
		"accentSoftColor": {
			"type": "string"
		},
		"surfaceColor": {
			"type": "string"
		},
		"lineColor": {
			"type": "string"
		}
	},
	"style": "file:./style.css"
}
