{
	"$schema": "https://schemas.wp.org/trunk/block.json",
	"apiVersion": 3,
	"name": "academy/course-instructors",
	"title": "Course Instructors",
	"category": "academy-course",
	"description": "Names and photos of the people teaching a course.",
	"keywords": [
		"instructor",
		"teacher",
		"author",
		"course"
	],
	"textdomain": "academy",
	"usesContext": [
		"postId",
		"postType"
	],
	"attributes": {
		"showAvatar": {
			"type": "boolean",
			"default": true
		},
		"avatarSize": {
			"type": "number",
			"default": 28
		},
		"prefix": {
			"type": "string"
		},
		"maxShown": {
			"type": "number",
			"default": 2
		}
	},
	"supports": {
		"html": false,
		"color": {
			"text": true,
			"background": true,
			"link": true
		},
		"spacing": {
			"margin": true,
			"padding": true
		},
		"typography": {
			"fontSize": true,
			"lineHeight": true,
			"__experimentalFontWeight": true,
			"textAlign": true
		},
		"interactivity": {
			"clientNavigation": true
		}
	},
	"editorScript": "academy-blocks-editor",
	"style": "file:./style.css",
	"render": "file:./render.php"
}
