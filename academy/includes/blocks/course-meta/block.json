{
	"$schema": "https://schemas.wp.org/trunk/block.json",
	"apiVersion": 3,
	"name": "academy/course-meta",
	"title": "Course Details",
	"category": "academy-course",
	"description": "Lessons, duration, level and number of students for a course.",
	"keywords": [
		"lessons",
		"duration",
		"level",
		"students",
		"meta",
		"course"
	],
	"textdomain": "academy",
	"usesContext": [
		"postId",
		"postType"
	],
	"attributes": {
		"showLessons": {
			"type": "boolean",
			"default": true
		},
		"showDuration": {
			"type": "boolean",
			"default": true
		},
		"showLevel": {
			"type": "boolean",
			"default": true
		},
		"showEnrolled": {
			"type": "boolean",
			"default": false
		},
		"showIcons": {
			"type": "boolean",
			"default": true
		}
	},
	"supports": {
		"html": false,
		"color": {
			"text": true,
			"background": true
		},
		"spacing": {
			"margin": true,
			"padding": true,
			"blockGap": true
		},
		"typography": {
			"fontSize": true,
			"lineHeight": true,
			"__experimentalFontWeight": true,
			"textAlign": true
		},
		"interactivity": {
			"clientNavigation": true
		}
	},
	"editorScript": "academy-blocks-editor",
	"style": "file:./style.css",
	"render": "file:./render.php",
	"styles": [
		{
			"name": "inline",
			"label": "Inline",
			"isDefault": true
		},
		{
			"name": "stacked",
			"label": "Stacked"
		},
		{
			"name": "chips",
			"label": "Chips"
		}
	]
}
