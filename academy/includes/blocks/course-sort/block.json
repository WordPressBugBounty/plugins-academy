{
	"$schema": "https://schemas.wp.org/trunk/block.json",
	"apiVersion": 3,
	"name": "academy/course-sort",
	"title": "Course Sort",
	"category": "academy",
	"description": "A sort menu and the number of courses. Course grids on the same page follow the chosen order.",
	"keywords": [
		"sort",
		"order",
		"results",
		"count",
		"course"
	],
	"textdomain": "academy",
	"attributes": {
		"showCount": {
			"type": "boolean",
			"default": true
		},
		"showLabel": {
			"type": "boolean",
			"default": true
		}
	},
	"supports": {
		"html": false,
		"color": {
			"text": true,
			"background": true
		},
		"spacing": {
			"margin": true,
			"padding": true
		},
		"typography": {
			"fontSize": true,
			"lineHeight": true
		}
	},
	"editorScript": "academy-blocks-editor",
	"viewScript": "academy-course-filters-view",
	"style": "file:./style.css",
	"render": "file:./render.php"
}
