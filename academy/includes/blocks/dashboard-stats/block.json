{
	"$schema": "https://schemas.wp.org/trunk/block.json",
	"apiVersion": 3,
	"name": "academy/dashboard-stats",
	"title": "Dashboard Numbers",
	"category": "academy",
	"description": "Number cards for the view someone is in: enrolled, completed, students…",
	"textdomain": "academy",
	"attributes": {
		"columns": {
			"type": "number",
			"default": 0
		},
		"cardStyle": {
			"type": "string",
			"enum": [
				"card",
				"soft",
				"minimal"
			],
			"default": "card"
		},
		"showIcons": {
			"type": "boolean",
			"default": true
		}
	},
	"supports": {
		"html": false,
		"color": {
			"background": true,
			"text": true,
			"link": true
		},
		"spacing": {
			"padding": true,
			"margin": true
		},
		"typography": {
			"fontSize": true,
			"lineHeight": true
		},
		"interactivity": true
	},
	"editorScript": "academy-blocks-editor",
	"render": "file:./render.php",
	"ancestor": [
		"academy/dashboard"
	]
}
