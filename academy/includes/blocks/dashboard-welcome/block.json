{
	"$schema": "https://schemas.wp.org/trunk/block.json",
	"apiVersion": 3,
	"name": "academy/dashboard-welcome",
	"title": "Dashboard Welcome",
	"category": "academy",
	"description": "A greeting with the person's name.",
	"textdomain": "academy",
	"attributes": {
		"text": {
			"type": "string",
			"default": ""
		},
		"showAvatar": {
			"type": "boolean",
			"default": false
		},
		"showDate": {
			"type": "boolean",
			"default": false
		}
	},
	"supports": {
		"html": false,
		"color": {
			"background": true,
			"text": true,
			"link": true
		},
		"spacing": {
			"padding": true,
			"margin": true
		},
		"typography": {
			"fontSize": true,
			"lineHeight": true
		},
		"interactivity": true
	},
	"editorScript": "academy-blocks-editor",
	"render": "file:./render.php",
	"ancestor": [
		"academy/dashboard"
	]
}
