{
	"$schema": "https://schemas.wp.org/trunk/block.json",
	"apiVersion": 3,
	"name": "academy/dashboard",
	"title": "Dashboard",
	"category": "academy",
	"description": "The dashboard people see after logging in: menu, top bar and pages.",
	"textdomain": "academy",
	"attributes": {
		"sidebar": {
			"type": "string",
			"enum": [
				"",
				"left",
				"right"
			],
			"default": ""
		}
	},
	"supports": {
		"html": false,
		"align": [
			"wide",
			"full"
		],
		"color": {
			"background": true,
			"text": true,
			"link": true
		},
		"spacing": {
			"padding": true
		},
		"typography": {
			"fontSize": true,
			"__experimentalFontFamily": true
		},
		"interactivity": true
	},
	"editorScript": "academy-blocks-editor",
	"render": "file:./render.php",
	"keywords": [
		"dashboard",
		"student",
		"account"
	],
	"style": "file:./style.css",
	"editorStyle": "file:./editor.css",
	"viewScriptModule": "file:./view.js"
}
