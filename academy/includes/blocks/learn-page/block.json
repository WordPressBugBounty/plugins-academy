{
	"$schema": "https://schemas.wp.org/trunk/block.json",
	"apiVersion": 3,
	"name": "academy/learn-page",
	"title": "Learn Page",
	"category": "academy",
	"description": "The page students take a course on: holds the top bar, curriculum, lesson and footer.",
	"keywords": [
		"learn",
		"lesson",
		"course player"
	],
	"textdomain": "academy",
	"attributes": {
		"sidebar": {
			"type": "string",
			"enum": [
				"",
				"left",
				"right"
			],
			"default": ""
		},
		"width": {
			"type": "string",
			"enum": [
				"",
				"standard",
				"wide",
				"focused"
			],
			"default": ""
		},
		"previewCourse": {
			"type": "number",
			"default": 0
		}
	},
	"supports": {
		"html": false,
		"color": {
			"background": true,
			"text": true,
			"link": true
		},
		"typography": {
			"fontSize": true,
			"lineHeight": true,
			"__experimentalFontFamily": true
		},
		"interactivity": true
	},
	"editorScript": "academy-blocks-editor",
	"style": "file:./style.css",
	"editorStyle": "file:./editor.css",
	"viewScriptModule": "file:./view.js",
	"render": "file:./render.php",
	"providesContext": {
		"academy/previewCourse": "previewCourse"
	}
}
