{
	"$schema": "https://schemas.wp.org/trunk/block.json",
	"apiVersion": 3,
	"name": "academy/registration-form",
	"title": "Registration Form",
	"category": "academy",
	"description": "A sign-up form for students or instructors, built from field blocks.",
	"keywords": [
		"register",
		"sign up",
		"form",
		"student",
		"instructor"
	],
	"textdomain": "academy",
	"attributes": {
		"role": {
			"type": "string",
			"enum": [
				"student",
				"instructor"
			],
			"default": "student"
		},
		"formId": {
			"type": "string",
			"default": ""
		},
		"submitLabel": {
			"type": "string",
			"default": ""
		},
		"redirectUrl": {
			"type": "string",
			"default": ""
		},
		"showLoginLink": {
			"type": "boolean",
			"default": true
		},
		"buttonColor": {
			"type": "string"
		}
	},
	"providesContext": {
		"academy/registrationRole": "role"
	},
	"supports": {
		"html": false,
		"align": [
			"wide",
			"full"
		],
		"color": {
			"text": true,
			"background": true,
			"link": true
		},
		"spacing": {
			"margin": true,
			"padding": true,
			"blockGap": true,
			"__experimentalDefaultControls": {
				"padding": true
			}
		},
		"typography": {
			"fontSize": true,
			"lineHeight": true
		},
		"__experimentalBorder": {
			"radius": true,
			"width": true,
			"color": true,
			"style": true,
			"__experimentalDefaultControls": {
				"color": true,
				"radius": true,
				"width": true,
				"style": true
			}
		},
		"shadow": true
	},
	"styles": [
		{
			"name": "default",
			"label": "Default",
			"isDefault": true
		},
		{
			"name": "card",
			"label": "Card"
		},
		{
			"name": "plain",
			"label": "Plain"
		}
	],
	"editorScript": "academy-blocks-editor",
	"editorStyle": "file:./editor.css",
	"style": "file:./style.css",
	"render": "file:./render.php"
}
